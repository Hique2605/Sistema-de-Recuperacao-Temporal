# Copie este arquivo para ".env" e preencha com os dados reais da câmera.
# NUNCA versione o .env de verdade (está no .gitignore).

CAMERA_IP=192.168.0.100
CAMERA_USUARIO=admin
CAMERA_SENHA=troque_esta_senha

# Caminho RTSP (Intelbras/Dahua). subtype=0 = stream principal (pesado de
# decodificar); subtype=1 = sub-stream (bem mais leve). Para reduzir CPU,
# use o sub-stream e configure-o na câmera (720p, 15 fps, bitrate baixo).
# Câmeras extras: CAMERA2_IP, CAMERA2_USUARIO, CAMERA2_SENHA, CAMERA2_RTSP_PATH...
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=1

# Vídeo / buffer (valores abaixo = recomendados p/ 2 câmeras em Raspberry Pi)
BUFFER_SECONDS=30
FPS=15
FRAME_WIDTH=1280
FRAME_HEIGHT=720
# Qualidade JPEG do buffer (1-100; 0 = frames crus, usa MUITA RAM)
BUFFER_JPEG_QUALIDADE=80
CAPTURE_BUFFERSIZE=1
TIMEOUT_PRIMEIRO_FRAME_S=10
RECONEXAO_APOS_FALHAS=100

INTERVALO_AMOSTRAGEM_METRICAS=1.0
PASTA_VIDEOS=gravacoes
PASTA_METRICAS=metricas
PASTA_LOGS=logs

# Retenção: apaga vídeos (video_*.mp4) com mais de N dias (mínimo 1)
RETENCAO_DIAS=2

# Botão físico via GPIO (Raspberry Pi) — deixe vazio se não for usar.
# Numeração BCM (a mesma usada pela lib gpiozero), não a física da placa.
GPIO_SALVAR_PIN=
GPIO_ENCERRAR_PIN=
# false = botão entre GPIO e 3,3 V (pull-down) | true = botão entre GPIO e GND
GPIO_PULL_UP=false

# E-mail automático após cada gravação (opcional)
EMAIL_ATIVADO=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_SENHA=
# EMAIL_REMETENTE=
# EMAIL_DESTINATARIO=
# Total de anexos (MB). Base64 aumenta ~33%: 18 -> ~24 MB, cabe nos 25 MB do Gmail.
EMAIL_TAMANHO_MAX_MB=18
